PORT=3000
HOST=127.0.0.1
# REQUIRED on Vercel: Supabase > Connect > Method: Transaction pooler.
# Replace the password placeholder; URL-encode special characters in the password.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@POOLER_HOST:6543/postgres
# Optional: separate connection with migration permissions. Defaults to DATABASE_URL.
# MIGRATION_DATABASE_URL=
# Vercel also recognizes an integration-provided POSTGRES_URL.
# Never expose database connection strings using NEXT_PUBLIC_ or VITE_ variables.
# Optional exact public origin. Vercel infers the origin from its trusted request host.
# APP_ORIGIN=https://finaltake.example.com
# Local development only, when no PostgreSQL URL is set:
# SQLITE_PATH=./data/final-take.sqlite
# Optional. Without a token, the app uses its curated starter catalog.
# TMDB_READ_TOKEN=
# TMDB_API_KEY=
